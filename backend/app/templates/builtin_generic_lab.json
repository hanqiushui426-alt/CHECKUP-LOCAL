{
  "id": "builtin_generic_lab",
  "name": "通用检验报告（表格式）",
  "category": "table",
  "report_type": "检验",
  "match": {
    "text_contains": [],
    "exclude": []
  },
  "patient": {
    "name_regex": "(?:患者)?姓名\\s*[:：]?\\s*([\\u4e00-\\u9fa5A-Za-z·•]{2,12})",
    "gender_regex": "性别\\s*[:：]?\\s*([男女])",
    "birth_regex": "(?:出生日期|出生年月|出生时间|生日|DOB)\\s*[:：]?\\s*((?:19|20)\\d{2})[年./\\-](\\d{1,2})[月./\\-](\\d{1,2})日?",
    "date_regex": "((?:19|20)\\d{2})\\s*[年./\\-]\\s*(\\d{1,2})\\s*[月./\\-]\\s*(\\d{1,2})\\s*日?"
  },
  "items": {
    "mode": "table",
    "columns": [
      { "key": "item", "aliases": ["检验项目", "项目名称", "测定项目", "检查项目", "检测项目", "项目", "指标"] },
      { "key": "value", "aliases": ["检验结果", "测定结果", "本次结果", "结果", "检验值"] },
      { "key": "unit", "aliases": ["单位"] },
      { "key": "ref", "aliases": ["参考范围", "参考区间", "参考值", "正常参考", "正常范围", "范围", "区间"] },
      { "key": "flag", "aliases": ["提示", "标志", "标记", "箭头"] },
      { "key": "method", "aliases": ["方法学", "检测方法", "方法"] }
    ]
  }
}
