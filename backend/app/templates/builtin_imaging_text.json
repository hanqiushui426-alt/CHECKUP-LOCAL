{
  "id": "builtin_imaging_text",
  "name": "影像/图文检查报告（文本归档）",
  "category": "text",
  "match": {
    "text_contains": ["影像所见", "超声描述", "检查所见", "X线表现", "MR表现", "报告医生", "诊断意见", "提示"],
    "exclude": ["参考范围", "参考区间"]
  },
  "patient": {
    "name_regex": "(?:患者)?姓名\\s*[:：]?\\s*([\\u4e00-\\u9fa5A-Za-z·•]{2,12})",
    "gender_regex": "性别\\s*[:：]?\\s*([男女])",
    "date_regex": "((?:19|20)\\d{2})\\s*[年./\\-]\\s*(\\d{1,2})\\s*[月./\\-]\\s*(\\d{1,2})\\s*日?"
  },
  "items": {
    "mode": "none"
  }
}
